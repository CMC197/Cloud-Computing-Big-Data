# Kopiere nach .env fuer lokale Overrides.

# Mock-Layer an (Default). Auf false setzen, um gegen die echte API zu gehen.
VITE_USE_MOCK=true

# Nur relevant, wenn VITE_USE_MOCK=false. Wird von window.__SMARTPARK_CONFIG__
# (ConfigMap im Cluster) uebersteuert, falls gesetzt.
VITE_API_URL=http://localhost:8000
